{
    "manifest_version": 3,
    "name": "ObserveX Monitor",
    "version": "1.0",

    "description": "We Reduce Human Error",
    "key": "",

    "permissions": [
        "tabs",
        "activeTab",
        "storage",
        "nativeMessaging"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_title": "ObserveX"
    }
    
}